region    = "us-east-1"
notifiers = "jira,github,linear"

jira_project_key = "OPS"
github_repo      = "clouddrove/your-repo"
linear_team_key  = "OPS"

jira_secret_arn   = "arn:aws:secretsmanager:us-east-1:111122223333:secret:aws-health-notifier/jira-XXXX"
github_secret_arn = "arn:aws:secretsmanager:us-east-1:111122223333:secret:aws-health-notifier/github-XXXX"
linear_secret_arn = "arn:aws:secretsmanager:us-east-1:111122223333:secret:aws-health-notifier/linear-XXXX"

default_priority = "Low"
done_transition  = "Done"
issue_label      = "aws-health"

priority_map = {
  AWS_EC2_INSTANCE_RETIREMENT_SCHEDULED = "High"
}

event_type_categories = ["scheduledChange"]

# Fewer notifiers? List only the ones you want, e.g. notifiers = "linear", and
# leave the other secrets unset. Each sink requires its own setting:
# github needs github_repo, jira needs jira_project_key, linear needs
# linear_team_key.

# Linear resolves the team and workflow state UUIDs from linear_team_key at
# runtime, so no UUIDs belong here. Set linear_done_state only if the issue
# should land in a completed state other than the team's first one:
# linear_done_state = "Shipped"

# Opt-in instance tag enrichment (reads Name/Environment tags from member
# accounts via a StackSet-deployed read role):
# enrich_tags = true
# org_root_id = "r-xxxx"
# tag_keys    = "Name,Environment"
